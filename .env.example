# ============================================================
#  Multilingual Translation Pipeline — Environment Configuration
# ============================================================
#
# Copy this file to .env and customize for your environment.
#   cp .env.example .env
#
# All values below are the defaults used when not set.
# ============================================================

# ── Ollama Connection ──
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=1800

# ── LLM Backend ──
# Options: ollama (default), ollama-cloud, openrouter, openai, google, anthropic
LLM_BACKEND=ollama

# ── Cloud LLM API Keys ──
# Only needed when LLM_BACKEND is not "ollama"
# OLLAMA_API_KEY=olk_...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AI...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Solana / Phantom ──
SOLANA_WALLET_ADDRESS=your_wallet_address_here
# Network: devnet (testing) | mainnet-beta (production)
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# USDC mint: devnet test token (mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v)
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Superadmin: the wallet with highest platform privileges
SUPERADMIN_WALLET=your_superadmin_wallet_here

# ── Language & Domain ── (ISO 639-1 codes)
# Supported langs: ja, vi, zh, zh-TW, ko, en, fr, de, es, th, id, ru, pt, ar, hi
# Supported domains: general, it, medical, legal, finance, marketing
SOURCE_LANG=auto
TARGET_LANG=en
DEFAULT_DOMAIN=general

# ── Model ──
MODEL=gemma4:31b-cloud

# ── Model Router (per-language overrides) ──
# Format: MODEL_{SOURCE}_{TARGET}=model_name
# Resolution order: exact pair+domain → pair → source → domain default → MODEL
# Examples:
#   MODEL_JA_VI=gemma4:e4b          # Japanese→Vietnamese
#   MODEL_DE_EN=gemma4:31b           # German→English (needs bigger model)
#   MODEL_ZH_TW=gemma4:31b           # Chinese Traditional (any target)
#   MODEL_DOMAIN_MEDICAL=gemma4:31b  # Medical domain (any language)
#   MODEL_JA_VI_LEGAL=gemma4:31b     # Japanese→Vietnamese legal docs

# ── Ollama Inference ──
# Thinking mode: true = model reasons before answering (slower, better for large models)
#                false = direct output (faster, recommended for small models like E4B on CPU)
OLLAMA_THINK=true

# ── Translation Parameters ──
TRANSLATION_TEMPERATURE=0.3
TRANSLATION_NUM_CTX=4096
TRANSLATION_MAX_RETRIES=3
MAX_CONCURRENT_BATCHES=5

# ── LLM Inference Parameters ──
TOP_K=20
TOP_P=0.7
REPETITION_PENALTY=1.05

# ── Extraction Parameters ──
MAX_INLINE_TAGS=8
MAX_SEGMENT_CHARS=500
BATCH_MAX_CHARS=3000
BATCH_MAX_SEGMENTS=12

# ── Paths ──
# For Docker deployment, use absolute paths like /data/output
# For local development, use relative paths like ./data/output
TEMP_DIR=./data/temp

# ── SurrealDB ──
SURREALDB_URL=ws://127.0.0.1:8000/rpc
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_NS=translate
SURREALDB_DB=mvp

# ── MinIO Configuration ──
MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── MinIO Enterprise Security ──
# Tự động xóa file sau N ngày (Retention Policy)
FILE_RETENTION_DAYS=14
# Mã hóa SSE-C tại ổ cứng (256-bit base64 key)
STORAGE_ENCRYPTION_KEY=

# ── JWT Authentication ──
# IMPORTANT: Change this to a random secret in production!
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=super-secret-key-please-change-in-prod

# ── Embedding Model (for Translation Memory fuzzy matching) ──
# Requires the model to be pulled in Ollama: ollama pull nomic-embed-text
EMBEDDING_MODEL=snowflake-arctic-embed2:568m
ENABLE_FUZZY_CACHE=true

# ── Workers ──
MAX_WORKERS=2

# ── Security ──
# Max upload file size in bytes (default: 50MB = 52428800)
MAX_FILE_SIZE=52428800
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set to false to disable self-registration
REGISTRATION_ENABLED=true

# ── Logging ──
# LOG_FORMAT: "json" for production (structured), "dev" for local (colored)
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=dev
LOG_LEVEL=INFO
